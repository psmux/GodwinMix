# Rust build output. The glob catches a crate built on its own, which happens
# to godwinmix-sdk and to templates/rust because a plugin crate is its own
# workspace.
/target/
**/target/
browser/target/
tauri-app/target/

# A plugin template is a crate, and its lockfile belongs to whoever copies it,
# not to this repository.
templates/*/Cargo.lock
crates/godwinmix-sdk/Cargo.lock

# Tauri generated schemas
tauri-app/gen/schemas/

# Local test rig: logs, runtime state, captures, and the mediamtx release
# binary dev/harness/up.sh downloads on first run.
dev/harness/logs/
dev/harness/bin/
dev/harness/*.runtime.toml
browser/dev/out/
browser/dev/out-arch/
browser/dev/rt-ctx/
browser/dev/godwinmix-browser

# Self-signed cert mediamtx generates on first run
auto.crt
auto.key

# Local tooling state
.omc/

.DS_Store
dev/linux-x86/out/
