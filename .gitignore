# Rust build output. The glob catches a crate built on its own, which happens
# to godwinmix-sdk and to templates/rust because a plugin crate is its own
# workspace.
/target/
**/target/
browser/target/
tauri-app/target/

# A plugin template is a crate, and its lockfile belongs to whoever copies it,
# not to this repository. The same goes for anything its check builds.
templates/*/Cargo.lock
crates/godwinmix-sdk/Cargo.lock
templates/go/bin/
# A plugin's built binary, copied beside its manifest so the manifest's `bin`
# path resolves. `cargo build --release -p gmx-<name>` then a copy; the
# plugin's README says the line.
plugins/*/bin/
templates/*/plugin

# Tauri generated schemas
tauri-app/gen/schemas/

# Local test rig: logs, runtime state, captures, and the mediamtx release
# binary dev/harness/up.sh downloads on first run.
dev/harness/logs/
dev/harness/bin/
dev/harness/*.runtime.toml
browser/dev/out/
browser/dev/out-arch/
browser/dev/rt-ctx/
browser/dev/godwinmix-browser

# Self-signed cert mediamtx generates on first run
auto.crt
auto.key

# Local tooling state
.omc/

.DS_Store
dev/linux-x86/out/

# A crate built on its own, outside the workspace, puts its target here.
crates/*/target/
clients/typescript/node_modules/
clients/typescript/dist/
clients/python/*.egg-info/
clients/**/__pycache__/

# The first party plugins are workspace members, so their binaries are staged
# into plugins/<name>/bin/ by dev/plugins.sh rather than committed.
# The staged binary a first party plugin is started from. `gmx plugin add`
# copies the plugin directory and the core runs `[run] bin` inside the copy, so
# the binary has to sit beside the manifest rather than in the workspace target
# directory. dev/harness/stage-plugins.sh puts it there.
plugins/*/bin/
plugins/*/target/
examples/*/target/

# A tier W plugin's component is committed rather than staged. It is the same
# bytes on every platform, it is 100 KB, and a checkout with no wasm toolchain
# still runs the replay test and the eval that need it. dev/build-wasm.sh
# rebuilds it from source.
!plugins/*/plugin.wasm
!examples/*/plugin.wasm

# Runtime crash reports can contain private machine paths and settings.
**/crashes/

# Python bytecode embeds the local source filename.
**/__pycache__/
*.pyc

# Agent worktrees, made by Claude Code while it works in parallel
.claude/worktrees/
