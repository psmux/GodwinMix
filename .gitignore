# Rust build output. The glob catches a crate built on its own, which happens
# to godwinmix-sdk and to templates/rust because a plugin crate is its own
# workspace.
/target/
**/target/
browser/target/
tauri-app/target/

# A plugin template is a crate, and its lockfile belongs to whoever copies it,
# not to this repository. The same goes for anything its check builds.
templates/*/Cargo.lock
crates/godwinmix-sdk/Cargo.lock
templates/go/bin/
# A plugin's built binary, copied beside its manifest so the manifest's `bin`
# path resolves. `cargo build --release -p gmx-<name>` then a copy; the
# plugin's README says the line.
plugins/*/bin/
templates/*/plugin

# Tauri generated schemas
tauri-app/gen/schemas/

# Local test rig: logs, runtime state, captures, and the mediamtx release
# binary dev/harness/up.sh downloads on first run.
dev/harness/logs/
dev/harness/bin/
dev/harness/*.runtime.toml
browser/dev/out/
browser/dev/out-arch/
browser/dev/rt-ctx/
browser/dev/godwinmix-browser

# Self-signed cert mediamtx generates on first run
auto.crt
auto.key

# Local tooling state
.omc/

.DS_Store
dev/linux-x86/out/

# A crate built on its own, outside the workspace, puts its target here.
crates/*/target/
clients/typescript/node_modules/
clients/typescript/dist/
clients/python/*.egg-info/
clients/**/__pycache__/
