  "uiSchema": [
    {
      "name": "declared controls beat inferred ones and a forgotten field still appears",
      "schema": {
        "type": "object",
        "properties": {
          "tolerance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "title": "Tolerance"
          },
          "key": {
            "type": "string",
            "title": "Key colour"
          },
          "spill": {
            "type": "number",
            "title": "Spill"
          },
          "notes": {
            "type": "string",
            "title": "Notes"
          }
        }
      },
      "ui": {
        "type": "vertical",
        "elements": [
          {
            "type": "group",
            "label": "Key",
            "elements": [
              {
                "type": "control",
                "scope": "#/properties/key",
                "control": "template.chroma"
              },
              {
                "type": "control",
                "scope": "#/properties/tolerance",
                "control": "slider"
              }
            ]
          },
          {
            "type": "control",
            "scope": "#/properties/spill",
            "control": "slider",
            "rule": {
              "effect": "show",
              "condition": {
                "scope": "#/properties/tolerance",
                "equals": 1
              }
            }
          }
        ]
      },
      "value": {
        "tolerance": 0.5
      },
      "out": {
        "controls": [
          {
            "field": "key",
            "control": "template.chroma",
            "visible": true,
            "enabled": true
          },
          {
            "field": "tolerance",
            "control": "slider",
            "visible": true,
            "enabled": true
          },
          {
            "field": "spill",
            "control": "slider",
            "visible": false,
            "enabled": true
          },
          {
            "field": "notes",
            "control": "text",
            "visible": true,
            "enabled": true
          }
        ]
      }
    },
    {
