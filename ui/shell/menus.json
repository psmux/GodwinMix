{
  "version": 1,
  "about": "The menu bar, once, for the page and for the desktop app's native menu. Each item names a command id from ui/shell/commands.js; `arg` is passed to it. `check` names a state the page shows as a tick. `plugins: true` stands for the plugin panels, which only the page knows, so the native menu skips it.",
  "menus": [
    {
      "id": "file",
      "title": "File",
      "items": [
        {
          "command": "project.new",
          "title": "New project…"
        },
        {
          "command": "project.open",
          "title": "Open project…"
        },
        {
          "command": "project.save",
          "title": "Save project as…"
        },
        {
          "separator": true
        },
        {
          "command": "show.new",
          "title": "New show…"
        },
        {
          "command": "show.add-many",
          "title": "New shows…"
        },
        {
          "command": "show.switch",
          "title": "Switch show…"
        },
        {
          "separator": true
        },
        {
          "command": "mixer.settings",
          "title": "Mixer settings…"
        },
        {
          "command": "shell.settings",
          "title": "Page settings…"
        }
      ]
    },
    {
      "id": "edit",
      "title": "Edit",
      "items": [
        {
          "command": "shell.undo",
          "title": "Undo"
        },
        {
          "command": "shell.redo",
          "title": "Redo"
