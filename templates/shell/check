#!/bin/sh
# Everything that can be checked without a core, in under thirty seconds.
#
#   ./check          run all of it
#   ./check --quick  skip the failing test you have not written yet
#
# python3 runs the tests. The plugin itself needs neither python3 nor anything
# else beyond sh and gst-launch-1.0.
#
# What the core's own harness adds on top (`gmx plugin test .`): real caps at
# the media end, ninety percent of the expected frames in three seconds, a kill
# mid stream with a restart, and the footprint this plugin costs.

set -eu

cd "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
python=${GMX_PYTHON:-python3}
shell=${GMX_SH:-sh}
quick=${1:-}
failed=0

step() {
    printf '%-34s' "$1"
    shift
    if output=$("$@" 2>&1); then
        echo "ok"
    else
        echo "FAILED"
        echo "$output" | sed 's/^/    /'
        failed=1
    fi
}

# The picture comes from GStreamer, so a machine without it cannot run this
# plugin at all and the transcript below would fail for a confusing reason.
gst_present() {
    if command -v gst-launch-1.0 >/dev/null 2>&1; then
        gst-launch-1.0 --version | head -1
        return 0
    fi
    echo "gst-launch-1.0 is not on PATH. Debian and Ubuntu:"
    echo "  sudo apt-get install -y gstreamer1.0-tools gstreamer1.0-plugins-good"
    echo "macOS: brew install gstreamer"
    return 1
}

echo "checking {{name}} with $shell, and $($python --version 2>&1) for the tests"

# 1. It parses. `sh -n` is the whole lint story for a POSIX shell script.
step "sh -n run.sh" "$shell" -n run.sh
step "sh -n tests/test_picture.sh" "$shell" -n tests/test_picture.sh
step "gst-launch-1.0" gst_present

# 2. The manifest. `gmx plugin test .` runs the full validator.
step "gmx-plugin.toml" "$python" tests/check_manifest.py

# 3. The protocol, replayed from a recording with no core running.
step "offline transcript" "$python" tests/replay.py tests/transcript.jsonl

# 4. Your own test. It fails until you write it.
if [ "$quick" = "--quick" ]; then
    printf '%-34s%s\n' "your picture" "skipped (--quick)"
else
    step "your picture" "$shell" tests/test_picture.sh
fi

if [ "$failed" -eq 0 ]; then
    echo "all checks passed"
else
    echo "something failed. Fix it, then run ./check again."
fi
exit "$failed"
