#!/bin/sh
# Everything that can be checked without a core, in under thirty seconds.
#
#   ./check          run all of it
#   ./check --quick  skip the failing test you have not written yet
#
# What the core's own harness adds on top (`gmx plugin test .`): real caps at
# the media end, ninety percent of the expected frames in three seconds, a kill
# mid stream with a restart, and the footprint this plugin costs.

set -eu

cd "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
go=${GMX_GO:-go}
quick=${1:-}
bin=bin/{{name}}
failed=0

step() {
    printf '%-34s' "$1"
    shift
    if output=$("$@" 2>&1); then
        echo "ok"
    else
        echo "FAILED"
        echo "$output" | sed 's/^/    /'
        failed=1
    fi
}

# gofmt exits 0 whether or not it found anything, so the listing is the result.
formatted() {
    out=$(gofmt -l . 2>&1)
    if [ -n "$out" ]; then
        echo "not gofmt'd:"
        echo "$out"
        echo "run: gofmt -w ."
        return 1
    fi
    return 0
}

echo "checking {{name}} with $("$go" version)"

# 1. Formatting, then the vet checks, then a build of every package.
if command -v gofmt >/dev/null 2>&1; then
    step "gofmt" formatted
else
    printf '%-34s%s\n' "gofmt" "skipped (it ships with Go; check your PATH)"
fi
step "go vet" "$go" vet ./...
step "go build" "$go" build ./...
step "go build -o $bin" "$go" build -o "$bin" .

# 2. The manifest. `gmx plugin test .` runs the full validator.
step "gmx-plugin.toml" "$go" run ./tests/check_manifest

# 3. The protocol, replayed from a recording with no core running.
step "offline transcript" "$go" run ./tests/replay tests/transcript.jsonl "$bin"

# 4. Your own test. It fails until you write it.
if [ "$quick" = "--quick" ]; then
    printf '%-34s%s\n' "your picture" "skipped (--quick)"
else
    step "your picture" "$go" test .
fi

if [ "$failed" -eq 0 ]; then
    echo "all checks passed"
else
    echo "something failed. Fix it, then run ./check again."
fi
exit "$failed"
