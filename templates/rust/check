#!/bin/sh
# Everything that can be checked without a core, in under thirty seconds on a
# warm target directory.
#
#   ./check          run all of it
#   ./check --quick  skip the failing test you have not written yet
#
# What the core's own harness adds on top (`gmx plugin test .`): real caps at
# the media end, ninety percent of the expected frames in three seconds, a kill
# mid stream with a restart, and the footprint this plugin costs.

set -eu

cd "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
quick=${1:-}
failed=0

step() {
    printf '%-34s' "$1"
    shift
    if output=$("$@" 2>&1); then
        echo "ok"
    else
        echo "FAILED"
        echo "$output" | sed 's/^/    /'
        failed=1
    fi
}

echo "checking {{name}} with $(cargo --version)"

# 1. Formatting and lint. Both are advisory if the component is not installed.
#
# `cargo fmt` without --all, and `--quiet` clippy on this package alone: a
# plugin is its own crate and has no business formatting or linting whatever
# else happens to be on disk around it.
if cargo fmt --version >/dev/null 2>&1; then
    step "cargo fmt" cargo fmt -- --check
else
    printf '%-34s%s\n' "cargo fmt" "skipped (rustup component add rustfmt)"
fi
if cargo clippy --version >/dev/null 2>&1; then
    step "cargo clippy" cargo clippy --all-targets --quiet -- -D warnings
else
    printf '%-34s%s\n' "cargo clippy" "skipped (rustup component add clippy)"
fi

# 2. It builds, and the unit tests in src/main.rs pass.
step "cargo build --release" cargo build --release --quiet
step "unit tests" cargo test --bins --quiet

# 3. The manifest, through the SDK's own validator. Same code as harness check 7.
step "gmx-plugin.toml" cargo run --quiet --bin check-manifest

# 4. The protocol, replayed from a recording with no core running.
step "offline transcript" cargo test --test offline --quiet

# 5. Your own test. It fails until you write it.
if [ "$quick" = "--quick" ]; then
    printf '%-34s%s\n' "your picture" "skipped (--quick)"
else
    step "your picture" cargo test --test your_picture --quiet
fi

if [ "$failed" -eq 0 ]; then
    echo "all checks passed"
else
    echo "something failed. Fix it, then run ./check again."
fi
exit "$failed"
