#!/bin/sh
# Everything that can be checked without a core, in under thirty seconds.
#
#   ./check          run all of it
#   ./check --quick  skip the failing test you have not written yet
#
# What the core's own harness adds on top (`gmx plugin test .`): real caps at
# the media end, ninety percent of the expected frames in three seconds, a kill
# mid stream with a restart, and the footprint this plugin costs.

set -eu

cd "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
node=${GMX_NODE:-node}
quick=${1:-}
failed=0

step() {
    printf '%-34s' "$1"
    shift
    if output=$("$@" 2>&1); then
        echo "ok"
    else
        echo "FAILED"
        echo "$output" | sed 's/^/    /'
        failed=1
    fi
}

# 1. Every file parses.
parses() {
    for file in main.js tests/replay.js tests/check_manifest.js tests/test_picture.js; do
        "$node" --check "$file" || return 1
    done
    return 0
}

# 2. The one mistake that ruins the video and nothing else: console.log writes
# to stdout, and stdout is the Matroska stream.
stdout_is_media() {
    if grep -n 'console\.log' main.js; then
        echo "console.log writes to stdout, and stdout is the Matroska stream."
        echo "Use log(), which writes one JSON-RPC notification to stderr."
        return 1
    fi
    return 0
}

echo "checking {{name}} with node $("$node" --version)"

step "syntax" parses
step "stdout is media" stdout_is_media

# 3. The manifest. `gmx plugin test .` runs the full validator.
step "gmx-plugin.toml" "$node" tests/check_manifest.js

# 4. The protocol, replayed from a recording with no core running.
step "offline transcript" "$node" tests/replay.js tests/transcript.jsonl

# 5. Your own test. It fails until you write it.
if [ "$quick" = "--quick" ]; then
    printf '%-34s%s\n' "your picture" "skipped (--quick)"
else
    step "your picture" "$node" tests/test_picture.js
fi

if [ "$failed" -eq 0 ]; then
    echo "all checks passed"
else
    echo "something failed. Fix it, then run ./check again."
fi
exit "$failed"
