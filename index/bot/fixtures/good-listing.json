{
  "name": "fixture-index",
  "title": "A fixture index that the bot accepts",
  "description": "Two entries, one bronze and one silver, both of them complete. Nothing in here should ever fail a check.",
  "owner": "psmux",
  "version": 1,
  "signing": {
    "identity_regexp": "^https://github\\.com/psmux/godwinmix-plugins/\\.github/workflows/listing\\.yml@refs/heads/main$",
    "oidc_issuer": "https://token.actions.githubusercontent.com"
  },
  "plugins": [
    {
      "name": "clock",
      "source": "psmux/gmx-clock",
      "description": "A source that draws the current time, large, on a solid background.",
      "tier": "bronze",
      "kinds": [
        "source"
      ],
      "license": "MIT",
      "repository": "https://github.com/psmux/gmx-clock",
      "skill": "SKILL.md",
      "policy": {
        "network": [],
        "secrets": [],
        "telemetry": "none"
      },
      "versions": [
        {
          "version": "0.2.0",
          "api": 1,
          "platforms": [
            "linux-x86_64",
            "macos-aarch64"
          ],
          "signed": true,
          "harness": [
            "linux-x86_64: 8/8"
          ]
        }
      ]
    },
    {
      "name": "ndi",
      "source": "psmux/gmx-ndi",
      "description": "NDI in and out, with discovery over mDNS.",
      "tier": "silver",
      "kinds": [
        "source",
        "output",
        "device"
      ],
      "license": "Apache-2.0",
      "repository": "https://github.com/psmux/gmx-ndi",
      "skill": "SKILL.md",
      "policy": {
        "network": [
          "mDNS discovery on the local segment",
          "NDI video and audio to and from named senders"
        ],
        "secrets": [],
        "telemetry": "none"
      },
      "versions": [
        {
          "version": "1.3.1",
          "api": 1,
          "platforms": [
            "linux-x86_64",
            "macos-aarch64",
            "windows-x86_64"
          ],
          "signed": true,
          "harness": [
            "linux-x86_64: 8/8",
            "macos-aarch64: 8/8",
            "windows-x86_64: 8/8"
          ]
        }
      ]
    }
  ]
}
