{
  "name": "fixture-index",
  "title": "A listing that invented a tier",
  "description": "There are four tiers and platinum is not one of them. The core would read this entry as custom and the operator would be told nothing was checked, so entry.tier refuses it here instead.",
  "owner": "psmux",
  "version": 1,
  "signing": {
    "identity_regexp": "^https://github\\.com/psmux/godwinmix-plugins/\\.github/workflows/listing\\.yml@refs/heads/main$",
    "oidc_issuer": "https://token.actions.githubusercontent.com"
  },
  "plugins": [
    {
      "name": "clock",
      "source": "psmux/gmx-clock",
      "description": "A source that draws the current time, large, on a solid background.",
      "tier": "platinum",
      "kinds": [
        "source"
      ],
      "license": "MIT",
      "repository": "https://github.com/psmux/gmx-clock",
      "skill": "SKILL.md",
      "policy": {
        "network": [],
        "secrets": [],
        "telemetry": "none"
      },
      "versions": [
        {
          "version": "0.2.0",
          "api": 1,
          "platforms": [
            "linux-x86_64"
          ],
          "signed": true,
          "harness": [
            "linux-x86_64: 8/8"
          ]
        }
      ]
    }
  ]
}
