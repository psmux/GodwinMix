{
  "id": "add-and-take",
  "instruction": "Add a camera called cam-jib showing colour bars and put it on air.",
  "tags": [
    "sources"
  ],
  "initial": {
    "sources": [
      {
        "id": "cam-wide",
        "uri": "test://smpte"
      },
      {
        "id": "cam-close",
        "uri": "test://ball"
      }
    ]
  },
  "expect_changes": [
    {
      "what": "source",
      "id": "cam-jib",
      "to": "connecting"
    },
    {
      "what": "source",
      "id": "cam-jib",
      "to": "live"
    },
    {
      "what": "program",
      "to": "cam-jib"
    }
  ],
  "settle_ms": 3500,
  "note": "connecting is announced before the source is built, so it is always seen; then live, then the take."
}
