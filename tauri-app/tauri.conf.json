{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiveboxMix",
  "version": "0.1.0",
  "identifier": "io.github.psmux.liveboxmix",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "LiveboxMix",
        "url": "http://localhost:8080",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "create": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png"
    ]
  }
}
