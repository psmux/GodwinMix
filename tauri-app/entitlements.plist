<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The hardened runtime exceptions every program in GodwinMix.app is signed
  with, by dev/sign-macos.sh. docs/how-to/sign-macos-builds.md says why each
  one is here.
-->
<plist version="1.0">
<dict>
	<!-- Chromium's V8 in the web page renderer, and wasmtime for a tier W plugin, write machine code at run time. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<!-- A GStreamer plugin or a plugin library somebody installs later is not signed by this team. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<!-- The desktop app starts the mixer with DYLD_LIBRARY_PATH pointing at the runtime inside it. -->
	<key>com.apple.security.cs.allow-dyld-environment-variables</key>
	<true/>
	<!-- Without these the hardened runtime denies the camera and the microphone with no prompt. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
