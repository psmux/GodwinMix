{
  "schemaVersion": 1,
  "id": "0199c000-0000-7004-8000-c0ffee000004",
  "name": "two-box",
  "canvas": {
    "width": 1920,
    "height": 1080,
    "fps": 30
  },
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "a"
    ],
    "properties": {
      "a": {
        "type": "string",
        "default": "",
        "title": "Left source",
        "x-gmx-kind": "source"
      },
      "b": {
        "type": "string",
        "default": "",
        "title": "Right source",
        "x-gmx-kind": "source"
      },
      "gap": {
        "type": "number",
        "default": 0.02,
        "minimum": 0.0,
        "maximum": 0.1,
        "title": "Gap",
        "description": "Space between the boxes, as a fraction of the canvas."
      }
    }
  },
  "scenes": [
    {
      "id": "0199c000-0000-7005-8000-c0ffee000005",
      "name": "Two boxes, side by side",
      "items": [
        {
          "id": "0199c000-0000-7006-8000-c0ffee000006",
          "name": "left",
          "content": {
            "source": "{{a}}"
          },
          "transform": {
            "position": {
              "x": 0,
              "y": 0
            },
            "rotation": 0,
            "scale": {
              "x": 1,
              "y": 1
            },
            "anchor": {
              "x": 0,
              "y": 0
            },
            "frame": {
              "w": 0,
              "h": 0
            },
            "fit": "cover",
            "align": "center"
          },
          "bind": {
            "position.x": "gap*W",
            "position.y": "gap*H",
            "frame.w": "(W - 3*gap*W)/2",
            "frame.h": "H - 2*gap*H"
          }
        },
        {
          "id": "0199c000-0000-7007-8000-c0ffee000007",
          "name": "right",
          "content": {
            "source": "{{b}}"
          },
          "transform": {
            "position": {
              "x": 0,
              "y": 0
            },
            "rotation": 0,
            "scale": {
              "x": 1,
              "y": 1
            },
            "anchor": {
              "x": 0,
              "y": 0
            },
            "frame": {
              "w": 0,
              "h": 0
            },
            "fit": "cover",
            "align": "center"
          },
          "bind": {
            "position.x": "gap*W + (W - 3*gap*W)/2 + gap*W",
            "position.y": "gap*H",
            "frame.w": "(W - 3*gap*W)/2",
            "frame.h": "H - 2*gap*H"
          }
        }
      ]
    }
  ]
}
