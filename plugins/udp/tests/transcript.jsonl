# One recorded conversation with the core, for udp/source. `core` lines are
# written to the plugin's stdin; `plugin` lines must appear on its stderr, in
# this order, as a subset of the real line. "*" matches any value.
#
# Replay it with `gmx plugin test plugins/udp --offline`. Port 0 means the
# operating system picks one, so nothing is left listening on a known port.
{"plugin": {"jsonrpc": "2.0", "id": 0, "method": "initialize", "params": {"plugin": "udp", "api": 1, "transports": ["container"]}}}
{"core": {"jsonrpc": "2.0", "id": 0, "result": {"core": "godwinmix", "version": "0.2.0", "api_level": 1, "api_compatible": 1, "canvas": {"width": 1280, "height": 720, "fps": 30}, "transport": "container", "media": "", "instance": "feed", "provide": "source", "params": {"uri": "udp://127.0.0.1:0"}}}}
{"plugin": {"jsonrpc": "2.0", "method": "initialized"}}
{"core": {"jsonrpc": "2.0", "id": 1, "method": "start", "params": {"canvas": {"width": 1280, "height": 720, "fps": 30}, "transport": "container", "media": ""}}}
{"plugin": {"jsonrpc": "2.0", "id": 1, "result": {"latency_ms": 0}}}
{"core": {"jsonrpc": "2.0", "id": 2, "method": "health", "params": {}}}
{"plugin": {"jsonrpc": "2.0", "id": 2, "result": {"state": "*"}}}
{"core": {"jsonrpc": "2.0", "id": 3, "method": "stats", "params": {}}}
{"plugin": {"jsonrpc": "2.0", "id": 3, "result": {"address": "*", "stats": "*"}}}
{"core": {"jsonrpc": "2.0", "id": 4, "method": "programs", "params": {}}}
{"plugin": {"jsonrpc": "2.0", "id": 4, "result": {"programs": "*", "chosen": "*"}}}
# A bound socket cannot move to another group underneath the stream, so
# configure says so rather than pretending.
{"core": {"jsonrpc": "2.0", "id": 5, "method": "configure", "params": {"params": {"uri": "udp://@239.1.1.1:5000", "program": 2}}}}
{"plugin": {"jsonrpc": "2.0", "id": 5, "result": {"applied": false, "restart_required": true, "reason": "*"}}}
{"core": {"jsonrpc": "2.0", "id": 6, "method": "teleport", "params": {}}}
{"plugin": {"jsonrpc": "2.0", "id": 6, "error": {"code": -32601, "message": "*"}}}
{"core": {"jsonrpc": "2.0", "id": 7, "method": "stop", "params": {}}}
{"plugin": {"jsonrpc": "2.0", "id": 7, "result": {}}}
{"core": {"jsonrpc": "2.0", "id": 8, "method": "shutdown", "params": {"reason": "offline test"}}}
{"plugin": {"jsonrpc": "2.0", "id": 8, "result": {}}}
