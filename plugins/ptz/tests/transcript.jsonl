# One recorded conversation with the core, replayed by `gmx plugin test
# --offline .` and by tests/offline.rs. `core` lines are written to the
# plugin's stdin; `plugin` lines must appear on its stderr, in this order, as
# a subset of the real line. "*" matches any value.
#
# No core, no camera, no clock: the one camera is the `fake` protocol, and
# GMX_RPC is empty, so there are no pictures and tracking says why.
{"plugin": {"jsonrpc": "2.0", "id": 0, "method": "initialize", "params": {"plugin": "ptz", "api": 1}}}
{"core": {"jsonrpc": "2.0", "id": 0, "result": {"core": "godwinmix", "version": "0.3.32", "api_level": 1, "api_compatible": 1, "canvas": {"width": 160, "height": 90, "fps": 30}, "transport": "container", "media": "", "instance": "ptz", "provide": "ptz", "params": {"cameras": [{"id": "cam-demo", "protocol": "fake"}], "data_dir": "../../target/ptz-offline"}}}}
{"plugin": {"jsonrpc": "2.0", "method": "log", "params": {"level": "info", "message": "*"}}}
{"plugin": {"jsonrpc": "2.0", "method": "initialized"}}
{"core": {"jsonrpc": "2.0", "id": 1, "method": "health", "params": {}}}
{"plugin": {"jsonrpc": "2.0", "id": 1, "result": {"state": "ok"}}}
{"core": {"jsonrpc": "2.0", "id": 2, "method": "tool.call", "params": {"name": "camera_list", "arguments": {}}}}
{"plugin": {"jsonrpc": "2.0", "id": 2, "result": {"structured_content": {"cameras": [{"id": "cam-demo", "protocol": "fake"}]}}}}
{"core": {"jsonrpc": "2.0", "id": 3, "method": "tool.call", "params": {"name": "move", "arguments": {"camera": "cam-demo", "pan": 0.5}}}}
{"plugin": {"jsonrpc": "2.0", "id": 3, "result": {"structured_content": {"camera": "cam-demo", "pan": 0.5, "hold_ms": 300}}}}
{"core": {"jsonrpc": "2.0", "id": 4, "method": "tool.call", "params": {"name": "track_observe", "arguments": {"camera": "cam-demo"}}}}
{"plugin": {"jsonrpc": "2.0", "id": 4, "error": {"code": -32001, "message": "*"}}}
{"core": {"jsonrpc": "2.0", "id": 5, "method": "tool.call", "params": {"name": "move", "arguments": {"camera": "cam-nave"}}}}
{"plugin": {"jsonrpc": "2.0", "id": 5, "error": {"code": -32004, "data": {"cameras": ["cam-demo"]}}}}
{"core": {"jsonrpc": "2.0", "id": 6, "method": "configure", "params": {"params": {"cameras": [{"id": "cam-demo", "protocol": "fake"}], "framing": "full"}}}}
{"plugin": {"jsonrpc": "2.0", "id": 6, "result": {"applied": true}}}
{"core": {"jsonrpc": "2.0", "id": 7, "method": "tool.call", "params": {"name": "no_such_tool", "arguments": {}}}}
{"plugin": {"jsonrpc": "2.0", "id": 7, "error": {"code": -32601, "message": "*"}}}
