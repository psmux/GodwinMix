# A recorded conversation with the core, replayed with no core, no sockets and
# no clock. Every step forces `element = "audiotestsrc"`, so the answer is the
# same on a machine with a sound card, a machine without one, and a CI runner.
{"plugin": {"jsonrpc": "2.0", "id": 0, "method": "initialize", "params": {"plugin": "audio-device", "api": 1}}}
{"core": {"jsonrpc": "2.0", "id": 0, "result": {"core": "godwinmix", "version": "0.2.0", "api_level": 1, "api_compatible": 1, "canvas": {"width": 320, "height": 180, "fps": 30}, "transport": "container", "media": "", "instance": "mic1", "provide": "source", "params": {"element": "audiotestsrc", "label": "Lectern mic"}}}}
{"plugin": {"jsonrpc": "2.0", "method": "initialized"}}
{"core": {"jsonrpc": "2.0", "id": 1, "method": "start", "params": {"canvas": {"width": 320, "height": 180, "fps": 30}, "transport": "container", "media": ""}}}
{"plugin": {"jsonrpc": "2.0", "id": 1, "result": {}}}
{"core": {"jsonrpc": "2.0", "id": 2, "method": "health", "params": {}}}
{"plugin": {"jsonrpc": "2.0", "id": 2, "result": {"state": "ok"}}}
# Gain and mute are read back in full, and what was not sent is left alone.
{"core": {"jsonrpc": "2.0", "id": 3, "method": "audio.set", "params": {"gain_db": -6}}}
{"plugin": {"jsonrpc": "2.0", "id": 3, "result": {"gain_db": -6.0, "muted": false}}}
{"core": {"jsonrpc": "2.0", "id": 4, "method": "audio.set", "params": {"muted": true}}}
{"plugin": {"jsonrpc": "2.0", "id": 4, "result": {"gain_db": -6.0, "muted": true}}}
# Layers belong to a source with a document in it, not to a microphone.
{"core": {"jsonrpc": "2.0", "id": 5, "method": "audio.set", "params": {"layers": {"page": 0.5}}}}
{"plugin": {"jsonrpc": "2.0", "id": 5, "error": {"code": -32602, "message": "*"}}}
# A gain change through configure lands without reopening the device.
{"core": {"jsonrpc": "2.0", "id": 6, "method": "configure", "params": {"params": {"element": "audiotestsrc", "label": "Lectern mic", "gain_db": 3}}}}
{"plugin": {"jsonrpc": "2.0", "id": 6, "result": {"applied": true}}}
{"core": {"jsonrpc": "2.0", "id": 7, "method": "tool.call", "params": {"name": "list_audio_inputs", "arguments": {}}}}
{"plugin": {"jsonrpc": "2.0", "id": 7, "result": {"structured_content": {"inputs": "*"}}}}
{"core": {"jsonrpc": "2.0", "id": 8, "method": "teleport", "params": {}}}
{"plugin": {"jsonrpc": "2.0", "id": 8, "error": {"code": -32601, "message": "*"}}}
{"core": {"jsonrpc": "2.0", "id": 9, "method": "stop", "params": {}}}
{"plugin": {"jsonrpc": "2.0", "id": 9, "result": {}}}
{"core": {"jsonrpc": "2.0", "id": 10, "method": "shutdown", "params": {"reason": "offline test"}}}
{"plugin": {"jsonrpc": "2.0", "id": 10, "result": {}}}
