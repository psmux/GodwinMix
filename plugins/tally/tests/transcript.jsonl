# One recorded conversation with the core, replayed by `gmx plugin test
# --offline .`. `core` lines are written to the plugin's stdin; `plugin` lines
# must appear on its stderr, in this order, as a subset of the real line. "*"
# matches any value.
#
# No core, no socket, no clock. GMX_RPC is empty, which is what a service gets
# when nobody gave it a mixer to watch: it comes up, says so, and answers.
{"plugin": {"jsonrpc": "2.0", "id": 0, "method": "initialize", "params": {"plugin": "tally", "api": 1}}}
{"core": {"jsonrpc": "2.0", "id": 0, "result": {"core": "godwinmix", "version": "0.2.0", "api_level": 1, "api_compatible": 1, "canvas": {"width": 160, "height": 90, "fps": 30}, "transport": "container", "media": "", "instance": "tally", "provide": "tally", "params": {"address": "127.0.0.1:18900", "lamps": [{"source": "cam1", "index": 0, "label": "CAM 1"}]}}}}
{"plugin": {"jsonrpc": "2.0", "method": "log", "params": {"level": "info", "message": "*"}}}
{"plugin": {"jsonrpc": "2.0", "method": "media.report", "params": {"latency_ms": 0}}}
{"plugin": {"jsonrpc": "2.0", "method": "initialized"}}
{"core": {"jsonrpc": "2.0", "id": 1, "method": "health", "params": {}}}
{"plugin": {"jsonrpc": "2.0", "id": 1, "result": {"state": "ok"}}}
{"core": {"jsonrpc": "2.0", "id": 2, "method": "configure", "params": {"params": {"protocol": "tcp", "address": "127.0.0.1:18901", "program_colour": "amber"}}}}
{"plugin": {"jsonrpc": "2.0", "id": 2, "result": {"applied": true}}}
