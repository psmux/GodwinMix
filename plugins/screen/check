#!/bin/sh
# Everything that can be checked without a core.
#
#   ./check
#
# What the core's harness adds on top (`gmx plugin test ./plugins/screen`):
# real caps at the media end, ninety percent of the expected frames in three
# seconds, a kill mid stream with a restart, and the footprint.

set -eu
cd "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
failed=0

step() {
    printf '%-34s' "$1"
    shift
    if output=$("$@" 2>&1); then
        echo "ok"
    else
        echo "FAILED"
        echo "$output" | sed 's/^/    /'
        failed=1
    fi
}

echo "checking screen with $(cargo --version)"

if cargo fmt --version >/dev/null 2>&1; then
    step "cargo fmt" cargo fmt -p gmx-screen -- --check
else
    printf '%-34s%s\n' "cargo fmt" "skipped (rustup component add rustfmt)"
fi
if cargo clippy --version >/dev/null 2>&1; then
    step "cargo clippy" cargo clippy -p gmx-screen --all-targets --quiet -- -D warnings
else
    printf '%-34s%s\n' "cargo clippy" "skipped (rustup component add clippy)"
fi

step "unit tests" cargo test -p gmx-screen --bins --quiet
step "gmx-plugin.toml" cargo run --quiet -p gmx-screen --bin check-manifest
step "offline transcript" cargo test -p gmx-screen --test offline --quiet
step "staged binary" ./build

if [ "$failed" -eq 0 ]; then
    echo "all checks passed"
else
    echo "something failed. Fix it, then run ./check again."
fi
exit "$failed"
