#!/bin/sh
# Stage the binary where the manifest says it is.
#
# This plugin is a member of the repository's cargo workspace, so its build
# output lands in the workspace target directory. `gmx plugin add` copies the
# plugin directory and skips anything named `target`, so the binary has to be
# somewhere else by the time the core looks for it. That is what this does.
#
#   ./build        build and stage bin/gmx-camera
#
# `gmx plugin add ./plugins/camera` runs this for you when bin/gmx-camera is not
# there yet, through the manifest's [build] section. Run it by hand when you
# want the build without the install.

set -eu
cd "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

: "${CARGO_TARGET_DIR:=$(cd ../.. && pwd)/target}"
export CARGO_TARGET_DIR

cargo build --release -p gmx-camera
mkdir -p bin
# Windows writes the binary with .exe after its name.
exe=""
[ -f "$CARGO_TARGET_DIR/release/gmx-camera.exe" ] && exe=.exe
cp "$CARGO_TARGET_DIR/release/gmx-camera$exe" "bin/gmx-camera$exe"
chmod +x "bin/gmx-camera$exe"
echo "staged bin/gmx-camera from $CARGO_TARGET_DIR/release"
