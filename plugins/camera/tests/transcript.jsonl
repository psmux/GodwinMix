# One recorded conversation with the core. `core` lines are written to the
# plugin's stdin; `plugin` lines must appear on its stderr, in this order, as a
# subset of the real line. "*" matches any value. Lines starting # are comments.
#
# Replay it with ./check, or with `gmx plugin test ./plugins/camera --offline`.
# No core, no sockets, no clock, and no camera: every step forces
# `element = "videotestsrc"` so the answer is the same on a machine with a
# camera, a machine without one, and a CI runner that has never had one.
{"plugin": {"jsonrpc": "2.0", "id": 0, "method": "initialize", "params": {"plugin": "camera", "api": 1}}}
{"core": {"jsonrpc": "2.0", "id": 0, "result": {"core": "godwinmix", "version": "0.2.0", "api_level": 1, "api_compatible": 1, "canvas": {"width": 320, "height": 180, "fps": 30}, "transport": "container", "media": "", "instance": "cam1", "provide": "source", "params": {"element": "videotestsrc", "label": "Camera 1"}}}}
{"plugin": {"jsonrpc": "2.0", "method": "initialized"}}
{"core": {"jsonrpc": "2.0", "id": 1, "method": "start", "params": {"canvas": {"width": 320, "height": 180, "fps": 30}, "transport": "container", "media": ""}}}
{"plugin": {"jsonrpc": "2.0", "id": 1, "result": {}}}
{"core": {"jsonrpc": "2.0", "id": 2, "method": "health", "params": {}}}
{"plugin": {"jsonrpc": "2.0", "id": 2, "result": {"state": "ok"}}}
# A label change is applied without touching the device.
{"core": {"jsonrpc": "2.0", "id": 3, "method": "configure", "params": {"params": {"element": "videotestsrc", "label": "Stage wide"}}}}
{"plugin": {"jsonrpc": "2.0", "id": 3, "result": {"applied": true}}}
# A frame rate change reopens the capture in place, and still answers applied.
{"core": {"jsonrpc": "2.0", "id": 4, "method": "configure", "params": {"params": {"element": "videotestsrc", "label": "Stage wide", "framerate": 25}}}}
{"plugin": {"jsonrpc": "2.0", "id": 4, "result": {"applied": true}}}
{"core": {"jsonrpc": "2.0", "id": 5, "method": "tool.call", "params": {"name": "list_cameras", "arguments": {}}}}
{"plugin": {"jsonrpc": "2.0", "id": 5, "result": {"structured_content": {"cameras": "*"}}}}
{"core": {"jsonrpc": "2.0", "id": 6, "method": "tool.call", "params": {"name": "list_unicorns", "arguments": {}}}}
{"plugin": {"jsonrpc": "2.0", "id": 6, "error": {"code": -32601, "message": "*"}}}
{"core": {"jsonrpc": "2.0", "id": 7, "method": "teleport", "params": {}}}
{"plugin": {"jsonrpc": "2.0", "id": 7, "error": {"code": -32601, "message": "*"}}}
{"core": {"jsonrpc": "2.0", "id": 8, "method": "stop", "params": {}}}
{"plugin": {"jsonrpc": "2.0", "id": 8, "result": {}}}
{"core": {"jsonrpc": "2.0", "id": 9, "method": "shutdown", "params": {"reason": "offline test"}}}
{"plugin": {"jsonrpc": "2.0", "id": 9, "result": {}}}
