# One recorded conversation with the core, for `ingest/rtmp`. `core` lines are
# written to the plugin's stdin; `plugin` lines must appear on its stderr, in
# this order, as a subset of the real line. "*" matches any value.
#
#   gmx plugin test plugins/ingest --offline
#
# Port 0 means the operating system picks one, so a run never collides with a
# mediamtx or another test on 1935 and nothing is left listening afterwards.
{"plugin": {"jsonrpc": "2.0", "id": 0, "method": "initialize", "params": {"plugin": "ingest", "api": 1, "transports": ["container"]}}}
{"core": {"jsonrpc": "2.0", "id": 0, "result": {"core": "godwinmix", "version": "0.2.0", "api_level": 1, "api_compatible": 1, "canvas": {"width": 1280, "height": 720, "fps": 30}, "transport": "container", "media": "", "instance": "phone", "provide": "rtmp", "params": {"bind": "127.0.0.1", "port": 0}}}}
{"plugin": {"jsonrpc": "2.0", "method": "initialized"}}
{"core": {"jsonrpc": "2.0", "id": 1, "method": "start", "params": {"canvas": {"width": 1280, "height": 720, "fps": 30}, "transport": "container", "media": ""}}}
{"plugin": {"jsonrpc": "2.0", "id": 1, "result": {"latency_ms": 0}}}
{"core": {"jsonrpc": "2.0", "id": 2, "method": "health", "params": {}}}
{"plugin": {"jsonrpc": "2.0", "id": 2, "result": {"state": "*"}}}
# Nobody has published, so stats say so and carry the address to hand out.
{"core": {"jsonrpc": "2.0", "id": 3, "method": "stats", "params": {}}}
{"plugin": {"jsonrpc": "2.0", "id": 3, "result": {"publishing": null, "bytes": 0, "address": "*"}}}
# The port is chosen when the socket binds, so moving it needs a reload.
{"core": {"jsonrpc": "2.0", "id": 4, "method": "configure", "params": {"params": {"bind": "127.0.0.1", "port": 1936}}}}
{"plugin": {"jsonrpc": "2.0", "id": 4, "result": {"applied": false, "restart_required": true, "reason": "*"}}}
{"core": {"jsonrpc": "2.0", "id": 5, "method": "teleport", "params": {}}}
{"plugin": {"jsonrpc": "2.0", "id": 5, "error": {"code": -32601, "message": "*"}}}
{"core": {"jsonrpc": "2.0", "id": 6, "method": "stop", "params": {}}}
{"plugin": {"jsonrpc": "2.0", "id": 6, "result": {}}}
{"core": {"jsonrpc": "2.0", "id": 7, "method": "shutdown", "params": {"reason": "offline test"}}}
{"plugin": {"jsonrpc": "2.0", "id": 7, "result": {}}}
