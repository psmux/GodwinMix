# One recorded conversation with the core, for `whip/output`. `core` lines are
# written to the plugin's stdin; `plugin` lines must appear on its stderr, in
# this order, as a subset of the real line. "*" matches any value.
#
#   gmx plugin test plugins/whip --offline
#
# The `start` step here is the failure path on purpose. An output reads the
# encoded programme from a FIFO the core makes, and there is no core in an
# offline replay, so the only honest thing to check is that the refusal names
# the field that is missing rather than crashing. The success path needs a live
# core and a WHIP endpoint; plugins/whip/README.md says how to get both.
{"plugin": {"jsonrpc": "2.0", "id": 0, "method": "initialize", "params": {"plugin": "whip", "api": 1}}}
{"core": {"jsonrpc": "2.0", "id": 0, "result": {"core": "godwinmix", "version": "0.2.0", "api_level": 1, "api_compatible": 1, "canvas": {"width": 1280, "height": 720, "fps": 30}, "transport": "container", "media": "", "instance": "away", "provide": "output", "params": {"endpoint": "https://example.com/whip/studio", "token": "a-token"}}}}
{"plugin": {"jsonrpc": "2.0", "method": "initialized"}}
{"core": {"jsonrpc": "2.0", "id": 1, "method": "health", "params": {}}}
{"plugin": {"jsonrpc": "2.0", "id": 1, "result": {"state": "*"}}}
# The token is set, and no answer this plugin gives ever says what it is.
{"core": {"jsonrpc": "2.0", "id": 2, "method": "stats", "params": {}}}
{"plugin": {"jsonrpc": "2.0", "id": 2, "result": {"endpoint": "https://example.com/whip/studio", "token": true, "reconnects": 0}}}
{"core": {"jsonrpc": "2.0", "id": 3, "method": "start", "params": {"canvas": {"width": 1280, "height": 720, "fps": 30}, "transport": "container", "media": ""}}}
{"plugin": {"jsonrpc": "2.0", "id": 3, "error": {"code": -32602, "message": "*"}}}
# An address that is not HTTP is refused whatever state the output is in.
{"core": {"jsonrpc": "2.0", "id": 4, "method": "configure", "params": {"params": {"endpoint": "srt://example.com:9000"}}}}
{"plugin": {"jsonrpc": "2.0", "id": 4, "error": {"code": -32602, "message": "*"}}}
{"core": {"jsonrpc": "2.0", "id": 5, "method": "configure", "params": {"params": {"endpoint": "https://example.com/whip/other"}}}}
{"plugin": {"jsonrpc": "2.0", "id": 5, "result": {"applied": true}}}
{"core": {"jsonrpc": "2.0", "id": 6, "method": "teleport", "params": {}}}
{"plugin": {"jsonrpc": "2.0", "id": 6, "error": {"code": -32601, "message": "*"}}}
# `start` failed, so the output is back in `stopped` and `stop` is refused with
# -32001 naming the state and what is legal in it. The SDK's state machine does
# this, not the plugin, and the transcript records it so a change is noticed.
{"core": {"jsonrpc": "2.0", "id": 7, "method": "stop", "params": {}}}
{"plugin": {"jsonrpc": "2.0", "id": 7, "error": {"code": -32001, "message": "*"}}}
{"core": {"jsonrpc": "2.0", "id": 8, "method": "shutdown", "params": {"reason": "offline test"}}}
{"plugin": {"jsonrpc": "2.0", "id": 8, "result": {}}}
