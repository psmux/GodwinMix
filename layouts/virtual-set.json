{
  "schemaVersion": 1,
  "id": "0199b000-0000-7040-8000-de5157ed0040",
  "name": "virtual-set",
  "canvas": {
    "width": 1920,
    "height": 1080,
    "fps": 30
  },
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "x-gmx-layered": true,
    "required": [
      "a",
      "b"
    ],
    "properties": {
      "a": {
        "type": "string",
        "default": "",
        "title": "Set",
        "description": "The picture or looping clip behind the presenter.",
        "x-gmx-kind": "source"
      },
      "b": {
        "type": "string",
        "default": "",
        "title": "Presenter",
        "description": "The camera in front of the green or blue screen. It is keyed.",
        "x-gmx-kind": "source"
      },
      "c": {
        "type": "string",
        "default": "",
        "title": "Foreground",
        "description": "A transparent picture in front of the presenter, such as a desk, drawn over the whole canvas.",
        "x-gmx-kind": "source"
      },
      "d": {
        "type": "string",
        "default": "",
        "title": "Lower third",
        "description": "A source for the lower third area, in front of everything else.",
        "x-gmx-kind": "source"
      },
      "key": {
        "type": "string",
        "default": "auto",
        "title": "Key colour",
        "description": "\"auto\" to find the screen colour in the picture, or a colour such as \"#30b050\".",
        "x-gmx-kind": "text"
      },
      "presenter_scale": {
        "type": "number",
        "default": 0.9,
        "minimum": 0.3,
        "maximum": 1.0,
        "title": "Presenter size",
        "description": "The presenter's picture as a fraction of the canvas, standing on its bottom edge."
      },
      "presenter_x": {
        "type": "number",
        "default": 0.5,
        "minimum": 0.0,
        "maximum": 1.0,
        "title": "Presenter position",
        "description": "Where the presenter stands across the canvas: 0 at the left, 0.5 in the middle, 1 at the right."
      }
    }
  },
  "scenes": [
    {
      "id": "0199b000-0000-7041-8000-de5157ed0041",
      "name": "Virtual set",
      "items": [
        {
          "id": "0199b000-0000-7042-8000-de5157ed0042",
          "name": "set",
          "content": {
            "source": "{{a}}"
          },
          "transform": {
            "position": { "x": 0, "y": 0 },
            "rotation": 0,
            "scale": { "x": 1, "y": 1 },
            "anchor": { "x": 0, "y": 0 },
            "frame": { "w": 0, "h": 0 },
            "fit": "cover",
            "align": "center"
          },
          "bind": {
            "position.x": "0",
            "position.y": "0",
            "frame.w": "W",
            "frame.h": "H"
          }
        },
        {
          "id": "0199b000-0000-7043-8000-de5157ed0043",
          "name": "presenter",
          "content": {
            "source": "{{b}}"
          },
          "transform": {
            "position": { "x": 0, "y": 0 },
            "rotation": 0,
            "scale": { "x": 1, "y": 1 },
            "anchor": { "x": 0, "y": 0 },
            "frame": { "w": 0, "h": 0 },
            "fit": "contain",
            "align": "bottom-center"
          },
          "bind": {
            "position.x": "presenter_x*(W - presenter_scale*W)",
            "position.y": "H - presenter_scale*H",
            "frame.w": "presenter_scale*W",
            "frame.h": "presenter_scale*H"
          },
          "filters": [
            {
              "type": "chroma/filter",
              "name": "Key",
              "params": {
                "color": "{{key}}"
              }
            }
          ]
        },
        {
          "id": "0199b000-0000-7044-8000-de5157ed0044",
          "name": "foreground",
          "content": {
            "source": "{{c}}"
          },
          "transform": {
            "position": { "x": 0, "y": 0 },
            "rotation": 0,
            "scale": { "x": 1, "y": 1 },
            "anchor": { "x": 0, "y": 0 },
            "frame": { "w": 0, "h": 0 },
            "fit": "contain",
            "align": "bottom-center"
          },
          "bind": {
            "position.x": "0",
            "position.y": "0",
            "frame.w": "W",
            "frame.h": "H"
          }
        },
        {
          "id": "0199b000-0000-7045-8000-de5157ed0045",
          "name": "lower third",
          "content": {
            "source": "{{d}}"
          },
          "transform": {
            "position": { "x": 0, "y": 0 },
            "rotation": 0,
            "scale": { "x": 1, "y": 1 },
            "anchor": { "x": 0, "y": 0 },
            "frame": { "w": 0, "h": 0 },
            "fit": "contain",
            "align": "center-left"
          },
          "bind": {
            "position.x": "0.05*W",
            "position.y": "0.74*H",
            "frame.w": "0.6*W",
            "frame.h": "0.16*H"
          }
        }
      ]
    }
  ]
}
