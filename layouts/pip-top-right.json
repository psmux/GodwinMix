{
  "schemaVersion": 1,
  "id": "0199b000-0000-700a-8000-de5157ed000a",
  "name": "pip-top-right",
  "canvas": {
    "width": 1920,
    "height": 1080,
    "fps": 30
  },
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "a"
    ],
    "properties": {
      "a": {
        "type": "string",
        "default": "",
        "title": "Main source",
        "x-gmx-kind": "source"
      },
      "b": {
        "type": "string",
        "default": "",
        "title": "Inset source",
        "x-gmx-kind": "source"
      },
      "inset": {
        "type": "number",
        "default": 0.28,
        "minimum": 0.1,
        "maximum": 0.6,
        "title": "Inset size",
        "description": "The inset's width and height, as a fraction of the canvas."
      },
      "gap": {
        "type": "number",
        "default": 0.05,
        "minimum": 0.0,
        "maximum": 0.2,
        "title": "Gap",
        "description": "Space around the inset, as a fraction of the canvas."
      }
    }
  },
  "scenes": [
    {
      "id": "0199b000-0000-700b-8000-de5157ed000b",
      "name": "Picture in picture, top right",
      "items": [
        {
          "id": "0199b000-0000-7008-8000-de5157ed0008",
          "name": "main",
          "content": {
            "source": "{{a}}"
          },
          "transform": {
            "position": {
              "x": 0,
              "y": 0
            },
            "rotation": 0,
            "scale": {
              "x": 1,
              "y": 1
            },
            "anchor": {
              "x": 0,
              "y": 0
            },
            "frame": {
              "w": 0,
              "h": 0
            },
            "fit": "cover",
            "align": "center"
          },
          "bind": {
            "position.x": "0",
            "position.y": "0",
            "frame.w": "W",
            "frame.h": "H"
          }
        },
        {
          "id": "0199b000-0000-7009-8000-de5157ed0009",
          "name": "inset",
          "content": {
            "source": "{{b}}"
          },
          "transform": {
            "position": {
              "x": 0,
              "y": 0
            },
            "rotation": 0,
            "scale": {
              "x": 1,
              "y": 1
            },
            "anchor": {
              "x": 0,
              "y": 0
            },
            "frame": {
              "w": 0,
              "h": 0
            },
            "fit": "cover",
            "align": "center"
          },
          "bind": {
            "position.x": "W - inset*W - gap*W",
            "position.y": "gap*H",
            "frame.w": "inset*W",
            "frame.h": "inset*H"
          }
        }
      ]
    }
  ]
}
